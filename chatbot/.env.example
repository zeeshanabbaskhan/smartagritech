# ──────────────────────────────────────────────
#  SmartAgriTech AI Chatbot — Environment Config
# ──────────────────────────────────────────────
#
# Copy this file to .env.local and fill in YOUR values.
# NEVER commit .env.local to git.

# ── Choose your AI provider: "groq" or "gemini" ──
VITE_AI_PROVIDER=groq

# ── Groq API Key (get free key at https://console.groq.com) ──
VITE_GROQ_API_KEY=your_groq_api_key_here
# Groq model — fast + free tier:
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini API Key (get free key at https://aistudio.google.com) ──
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model:
VITE_GEMINI_MODEL=gemini-1.5-flash

# ── SmartAgriTech backend API URL (read-only usage) ──
# Used to fetch live device/alarm data as context for the AI.
# Set to your running backend, e.g.:
VITE_API_URL=http://localhost:5000/api
