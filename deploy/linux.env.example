# ═══════════════════════════════════════════════════════════════════════════════
# Linux server deployment — Smart AgriTech EMS (Docker Compose)
# ═══════════════════════════════════════════════════════════════════════════════
#
# On the server (e.g. /opt/smartagritech/):
#   docker-compose.yml   ← from deploy/docker-compose.yml
#   .env                 ← copy this file, fill in values
#   backend/             ← filled by CI / pack-backend.sh extract
#   frontend/            ← filled by CI / pack-frontend.sh extract
#
# Reverse proxy (nginx/Caddy) should terminate TLS and forward:
#   https://api.yourdomain.com  → 127.0.0.1:9001  (WebSocket support on)
#   https://app.yourdomain.com  → 127.0.0.1:8080
#
# ─── Compose / DB (host PostgreSQL + Redis — recommended) ───
# Backend container reaches the Linux host via host.docker.internal
#
# DATABASE_URL format:
#   postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME?schema=public
# REDIS_URL format:
#   redis://host.docker.internal:6379
#
# Example after creating user/db on the host:
DATABASE_URL=postgresql://ems:CHANGE_ME_strong_password@host.docker.internal:5432/ems?schema=public
REDIS_URL=redis://host.docker.internal:6379

# Only needed if you use: docker compose --profile bundled-db up -d
POSTGRES_USER=ems
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=ems

BACKEND_HOST_PORT=9001
FRONTEND_HOST_PORT=8080

# ─── Backend app ───
NODE_ENV=production
PORT=9001

JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_DAYS=30
INGEST_API_KEY=CHANGE_ME_ingest_key
CLIENT_URL=http://YOUR_SERVER_IP:8080

INGEST_WORKER_CONCURRENCY=4
INGEST_BATCH_MAX=50
INGEST_BATCH_MS=100
SKIP_PG_CURRENT_VALUE=true
VALUE_FLUSH_MS=60000
# Offline is driven by MQTT bridge stop/offline (not a stale-reading timeout)
DEVICE_PRESENCE_CHECK_MS=60000
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_POOL_TIMEOUT_MS=10000

# Optional — file uploads & email
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NODEMAILER_USER=
# NODEMAILER_PASS=

# Seed on first start (set false after initial setup if desired)
# SEED_ON_START=true

# ─── Frontend (build-time only) ───
# No domain — pack with HTTP + IP:port:
#   .\scripts\deploy\pack-all.ps1 -ApiHost "http://YOUR_SERVER_IP:9001"
#   BACKEND_PUBLIC_HOST secret: http://YOUR_SERVER_IP:9001
#
# With a domain later:
#   .\scripts\deploy\pack-all.ps1 -ApiHost "api.yourdomain.com"
# Result:
#   VITE_API_URL=http://YOUR_SERVER_IP:9001/api
#   VITE_SOCKET_URL=http://YOUR_SERVER_IP:9001

# ─── GitHub Actions secrets ───
#
# Shared (both workflows):
#   DEPLOY_HOST          server hostname or IP (e.g. 203.0.113.10 or ems.yourdomain.com)
#   DEPLOY_USER          SSH user (e.g. deploy)
#   DEPLOY_SSH_KEY       private key (PEM) with access to DEPLOY_USER@DEPLOY_HOST
#   DEPLOY_PATH          absolute path on server (e.g. /opt/smartagritech)
#
# Frontend workflow only:
#   BACKEND_PUBLIC_HOST  api.yourdomain.com  (hostname ONLY — no https://, no /api)
#
# Optional:
#   DEPLOY_SSH_PORT      SSH port if not 22 (default 22)
#
# Server prerequisites:
#   - Docker Engine + Compose plugin (docker compose)
#   - DEPLOY_PATH exists with docker-compose.yml and .env
#   - DEPLOY_USER can run docker (docker group) without sudo
#
# ─── Manual pack (Windows) ───
#   .\scripts\deploy\pack-all.ps1 -ApiHost "api.yourdomain.com"
#
# ─── Manual pack (Linux / Mac) ───
#   ./scripts/deploy/pack-backend.sh
#   ./scripts/deploy/pack-frontend.sh api.yourdomain.com
